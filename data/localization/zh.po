
# ============================================================================
# Copilot mod - Chinese (Simplified) localization
#
# Mods use the same virtual file system as scripts, so this file is APPENDED to the
# game's own data/localization/zh.po. The game's language option therefore picks the
# translation up automatically; the mod needs no language switch of its own.
#
# A msgid must match character for character what the script passes to %_t, including
# \n escapes and %1% placeholders.
#
# Strings that already exist in the base game are deliberately NOT repeated here:
#   "Enable" -> 启用     "Disable" -> 禁用     "Idle" -> 待命
#   "ON" -> 开           "OFF" -> 关           "none" -> 无
# ============================================================================

# ---------- ship panel ----------
msgid "Copilot"
msgstr "副驾驶"

msgid "Autopilot: ON"
msgstr "自动驾驶：开"

msgid "Autopilot: OFF"
msgstr "自动驾驶：关"

msgid "Hand the ship you are currently flying over to the AI."
msgstr "把你当前驾驶的舰船交给 AI 接管。"

msgid "Auto-explore after clearing a sector"
msgstr "清空星区后自动跃迁"

msgid "Allow the AI to jump into neighbouring sectors once the current one is empty."
msgstr "允许 AI 在当前星区清空后跃迁到相邻星区。"

msgid "Ships operated by the AI"
msgstr "AI 自动运营的舰船"

msgid "Only ticked ships are ever touched. Everything else is left alone.\nThe decision layer itself is not wired up yet - this only stores your selection."
msgstr "只有打勾的舰船会被接管，其它一律不碰。\n决策层尚未接入，这里目前只保存你的选择。"

# ---------- autopilot state shown in the panel ----------
msgid "Engaging hostiles"
msgstr "交战中"

msgid "Mining asteroids"
msgstr "采集中"

msgid "Salvaging wreckage"
msgstr "打捞中"

msgid "Cargo full, parked"
msgstr "货舱已满，停泊中"

msgid "Jumping to a new sector"
msgstr "跃迁中"

msgid "Sector cleared, waiting"
msgstr "星区已清空，待命"

# ---------- chat command ----------
msgid "Copilot enabled. Your current ship now flies itself."
msgstr "副驾驶已启用：你当前驾驶的舰船将自动行动。"

msgid "Copilot disabled."
msgstr "副驾驶已关闭。"

msgid "Copilot will now jump to new sectors when the current one is cleared."
msgstr "副驾驶现在会在星区清空后跃迁到新星区。"

msgid "Copilot will no longer auto-jump."
msgstr "副驾驶不再自动跃迁。"

msgid "Copilot auto-explore is %1%. Use /copilot explore on|off."
msgstr "副驾驶自动探索：%1%。用 /copilot explore on|off 切换。"

msgid "Copilot is ON, controlling %1%."
msgstr "副驾驶已开启，正在控制 %1%。"

msgid "Copilot is ON, but you are not in a ship."
msgstr "副驾驶已开启，但你不在舰船上。"

msgid "Copilot is OFF."
msgstr "副驾驶已关闭。"

msgid "Ships operated by the AI (%1%): %2%"
msgstr "AI 自动运营的舰船（%1% 艘）：%2%"

msgid "Copilot: /copilot on | off | explore on|off | status | ops | reload | probe"
msgstr "Copilot：/copilot on | off | explore on|off | status | ops | reload | probe"

msgid "Toggle the Copilot autopilot that plays your current ship"
msgstr "开关副驾驶自动驾驶，接管你当前驾驶的舰船"

msgid "Usage: /copilot on | off | explore on|off | status | ops | reload | probe"
msgstr "用法：/copilot on | off | explore on|off | status | ops | reload | probe"

# 玩家手动接管：autopilot 被玩家关掉了
msgid "Copilot: manual control detected - handing the ship back."
msgstr "检测到手动操作，自动驾驶已交还。"

# 战略指挥层
msgid "Copilot ops: no ship designated (tick ships in the Copilot panel)."
msgstr "Copilot 战略指挥：没有指定任何船（请在 Copilot 面板里打勾）。"

msgid "Copilot ops: designated ships"
msgstr "Copilot 战略指挥：已指定的舰船"

# 接管提示：告诉玩家怎么把控制权收回来（否则会出现"船怎么点都不动"的困惑）
msgid "This ship is under Copilot control. Click the Copilot button (top right) or use /copilot off to take it back."
msgstr "本舰正由副驾驶接管。点右上角 Copilot 按钮、或用 /copilot off 即可收回控制权。"

# 面板：每船目标选项
msgid "No task assigned"
msgstr "不指派"

msgid "Mine"
msgstr "采矿"

msgid "Salvage"
msgstr "打捞"

msgid "Trade"
msgstr "贸易"

msgid "Travel"
msgstr "跃迁"

# ---------- 面板：舰船列表的列头与自检行（2026-10-19）----------
# 主人真机反馈「第 0 列一个勾都没有」的根因：ListBoxEx 的 CheckBox 把「已勾」画成
# **实心方块**、没有 ✓ 号 → 于是加了列头 + 第 1 列的文字镜像 + 底部名单自检行 ✓
msgid "OK"
msgstr "✓"

# ★ 2026-10-19 主人决定：**不做快捷键，改成 RPC 原子** `query {what="panel", action=...}` ✓
msgid "Copilot (open it over RPC too: query {what=\"panel\", action=\"open\"})"
msgstr "副驾驶（也可以用 RPC 打开：query {what=\"panel\", action=\"open\"}）"

msgid "Take-over"
msgstr "接管状态"

msgid "Auto/P"
msgstr "本船自驾"

msgid "Task"
msgstr "任务"

# ---------- 任务列：默认「自动」（2026-10-19）----------
# 主人：「很大程度上我是让决策者根据船的分类、装备决定船做什么，我自己并不会去设定它」
# → 默认就是自动/不指派（决策层按分类+装备自己定 ✓）；要指派走下面的自然语言输入框 ✓
#   （预设按钮已按主人第二次修正**去掉** ✗）
msgid "Auto"
msgstr "自动"

msgid "Tick here = hand this ship to the AI. This is the roster the plugin reads."
msgstr "在这里打勾 = 把这艘船交给 AI 管。插件读的就是这一列。"

msgid "Read-only mirror of column 1, spelled out (the tick itself renders as a filled box)."
msgstr "第 1 列勾的可读镜像（勾本身在界面上是个实心方块，没有 ✓ 号）。"

msgid "The ship's own autopilot flag (copilot_auto_cfg). Stored only - the decision layer does not read it yet."
msgstr "这艘船自己的自动驾驶员开关（copilot_auto_cfg）。目前只存着 —— 决策层还没读它。"

msgid "Taken over"
msgstr "已接管"

msgid "Not taken over"
msgstr "未接管"

msgid "Roster (panel / server): "
msgstr "名单（面板 / 服务端）："

# ---------- 任务列：默认自动 + 自然语言输入框（2026-10-19 主人第二次修正）----------
# 主人：「不是空目标叫自动，而是默认就是自动、不指派；如果需要能够指派，
#         最好是留个框，让玩家输入自然语言，而不是只给几个选项」✓✓
msgid "Goal text: click a ship row first (empty = Auto)"
msgstr "目标文字：先点一艘船的行，在这里写（清空 = 自动）"

msgid "Goal text for "
msgstr "目标文字："

msgid "Save goal"
msgstr "保存目标"

msgid "Limited: "
msgstr "限定："

msgid "The ship's real goal. Default = Auto (nothing assigned: the AI decides from the ship's class and equipment). To assign, click a row and type a sentence below (stored as copilot_goal_<ship>). A read-only action whitelist set over RPC shows as 'Limited'."
msgstr "这艘船的真实目标。默认「自动」= 不指派（AI 按船的分类与装备自己定）。要指派就点一行、在下面输入框里写一句话（存进 copilot_goal_<船名>）。RPC 设的动作白名单会以「限定」只读显示。"

msgid "Column 1 is the ONLY switch: it is the roster the AI really uses (a tick renders as a FILLED box, column 2 spells it out).\nColumn 3 is read-only: the per-ship autopilot is stored but not wired into the decision layer yet.\nColumn 4 = Task. Default is Auto: nothing assigned, the AI decides from the ship's class and equipment. To assign, click a ship row and type a sentence in the goal box below (empty = Auto again).\nThis window can also be opened/closed over RPC: query {what=\"panel\", action=\"open\"|\"close\"|\"toggle\"}."
msgstr "只有第 1 列是开关：它就是 AI 真正用的接管名单（勾在界面上是个「实心方块」，第 2 列会把它写成文字）。\n第 3 列只是只读：那艘船自己的自动驾驶员开关，决策层还没接入。\n第 4 列是任务。默认「自动」= 不指派：AI 按船的分类与装备自己定。要指派就点一行、在下面的输入框里写一句话（清空 = 回到自动）。\n本窗口也能用 RPC 开关：query {what=\"panel\", action=\"open\"|\"close\"|\"toggle\"}。"

# 缺船长：硬门槛，只提示一次（否则每 tick 重试会刷屏）
msgid "Copilot: this ship needs a captain before it can mine or salvage."
msgstr "副驾驶：本舰需要一名船长才能采矿或打捞。"

# ---------- 聊天命令层已退役（2026-10-18）----------
# 下面这几条是"退役说明"：/copilot 的任何子命令都只回一句「已退役，请用面板 / RPC」。
# 旧的那些指令串（"Copilot: /copilot on | off | ..." 等）仍留在上面，原因是
# 对应的 Lua 字面量还在 cli.lua 里（没人调、但没删 ✓）—— 留着它们不影响任何东西。
msgid "/copilot chat commands are retired. Use the Copilot panel (top right), or the fleet_query RPC atoms (mountQuote / mountUpgrade / shipQuote / blockQuote / blockUpgrade / shipUpgrade)."
msgstr "「/copilot」聊天命令已退役。请用右上角的 Copilot 面板，或 fleet_query 的 RPC 原子（mountQuote / mountUpgrade / shipQuote / blockQuote / blockUpgrade / shipUpgrade）。"

msgid "/copilot reload is retired too: code changes now take effect after reloading the save or restarting the game."
msgstr "「/copilot reload」也已退役：改代码现在要重载存档或重启游戏才生效。"

msgid "/copilot netstop|netstart stays disabled: both broke the net chain in the 2026-10-17 live tests. To make net changes take effect, reload the save or restart the game."
msgstr "「/copilot netstop|netstart」保持停用：2026-10-17 两次真机实测都把 net 链搞坏了（只发不收）。net 改动要生效，请重载存档或重启游戏。"

msgid "Copilot (chat commands retired; use the panel)"
msgstr "副驾驶（聊天命令已退役，请用面板）"

msgid "Usage: /copilot (retired) - use the Copilot panel (top right) or the fleet_query RPC atoms"
msgstr "用法：/copilot 已退役 —— 请用右上角的 Copilot 面板，或 fleet_query 的 RPC 原子"
