{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "types": ["node"],
    "declaration": true,
    "declarationDir": "lib/types",
    "outDir": "lib",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "paths": {
      "@deepseek-ai/dsh-llm": ["./types/dsh-stubs.d.ts"],
      "@deepseek-ai/dsh-llm/types": ["./types/dsh-stubs.d.ts"],
      "@deepseek-ai/dsh-tools": ["./types/dsh-stubs.d.ts"]
    }
  },
  "include": ["src", "types"]
}
