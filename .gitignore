# ---- 构建产物：唯一输出目录 = 仓库根 build/（中间物 / DLL / 测试台 lua.exe 全放这儿）✓
#      2026-10-19：产物不再落在 native/ 里（native/ 只放源码）✓
build/
*/obj/
*.obj
*.lib
*.exp
*.pdb
*.ilk

# ---- 编译出来的 Lua 副本（从 lua.org 下载，见 NATIVE.md；体积大且可重建）----
native/lua-src/

# ---- 独立测试台的可执行文件（可重建）----
native/harness/*.exe

# ---- DLL 产物（构建生成，游戏实际用的是 bin/ 下那份）----
native/copilot.dll
bin/copilot.dll

# ---- 日志与临时文件 ----
*.log
native/*_log.txt
native/abi_stage.txt
native/native_abi_proof.txt
native/req_test.txt

# ---- 本 agent 的截图（验证过程用，不入库）----
native/_shots/

# ---- 编辑器/系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini
# ---- 所有 DLL 都是构建产物（含实验探针）----
*.dll

# 存档备份（大文件，不入库 ✓）
saves-backup*/

# ---- DSH 插件（在 plugin/dsh/）：构建期临时依赖，不入库 ✓（lib/ 是产物但 DSH 要读它，故保留跟踪 ✓）----
plugin/dsh/node_modules/
plugin/dsh/.dsh-links/
node_modules/
node_modules.bak/

# ---- 验证证据（截图 / 抓包 / 存档快照）：含本机绝对路径，且体积大（本机实测 100 MB+）→ 绝不入库 ✓ ----
tools/_evidence/

# ---- 一次性诊断脚本（tmp-*.mjs：取证跑完即弃，别留库 ✓）----
tmp-*.mjs

# ---- 本地环境变量 / 凭据（含 token 一律不入库 ✓）----
.env
.env.*
